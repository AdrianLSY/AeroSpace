# Ignore everything in the root by default.
# New root entries must be explicitly added with `git add -f`
# New root directories must be explicitly listed below
/*

# Top level dirs
!/.bundle
!/.github
!/Sources
!/axDumps
!/dev-docs
!/docs
!/grammar
!/legal
!/resources
!/script
!/xcode

# Top level important files
!/*.sh
!/.editorconfig
!/.gitattributes
!/.gitignore
!/CONTRIBUTING.md
!/Gemfile
!/Package.resolved
!/Package.swift
!/README.md

/xcode/.xcode-build

# XCode User settings
xcuserdata/
xcshareddata/

/openspec

# graphify knowledge graph. The graph itself is committed so it is queryable
# from a fresh clone. These are not: cache/ is a regenerable cache keyed to the
# graphify version, *.bak are throwaway snapshots, and .graphify_python /
# .graphify_root store absolute paths that are wrong on any other machine.
/graphify-out/cache/
/graphify-out/*.bak
/graphify-out/.graphify_python
/graphify-out/.graphify_root
